# sito-auth base URL (sign-in, refresh, session, password reset)
VITE_AUTH_URL=http://localhost:8081

# Sito Notes API base URL (notes, profiles)
VITE_API_URL=http://localhost:8083

# Optional, dev only: proxy remote servers that reject the localhost origin.
# Set VITE_AUTH_URL=/proxy/auth and VITE_API_URL=/proxy/api to use them.
# DEV_PROXY_AUTH_TARGET=https://api.auth.sito8943.com
# DEV_PROXY_API_TARGET=https://api.notes.sito8943.com
